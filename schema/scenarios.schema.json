{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/base-usdc-payment-qa-kit/schema/scenarios.schema.json",
  "title": "Synthetic Payment QA Fixture Dataset Envelope",
  "description": "Intentionally malformed test payloads are allowed within a valid fixture envelope. This schema is not an onchain receipt validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dataset", "not_for_production", "description", "cases"],
  "properties": {
    "version": {"const": "0.1.0"},
    "dataset": {"type": "string", "minLength": 1},
    "not_for_production": {"const": true},
    "description": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "assumptions", "expected", "order", "proof", "prior_claim_keys", "rpc_views"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "description": {"type": "string", "minLength": 1},
        "assumptions": {"type": "string"},
        "expected": {"type": "string", "minLength": 1},
        "order": {"$ref": "#/$defs/order"},
        "proof": {"$ref": "#/$defs/proof"},
        "prior_claim_keys": {"type": "array", "items": {"type": "string"}},
        "rpc_views": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/rpc"}}
      }
    },
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["order_id", "network", "asset", "recipient", "payer", "amount_atomic", "decimals", "binding_verified"],
      "properties": {
        "order_id": {"type": "string"}, "network": {"type": "string"},
        "asset": {"type": "string"}, "recipient": {"type": "string"}, "payer": {"type": "string"},
        "amount_atomic": {"type": "string"}, "decimals": {"type": "integer"},
        "binding_verified": {"type": "boolean"}
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "transaction_hash", "log_index"],
      "properties": {"network": {"type": "string"}, "transaction_hash": {"type": "string"}, "log_index": {"type": "integer"}}
    },
    "rpc": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "chain_id", "available", "finalized_block", "receipt"],
      "properties": {
        "provider": {"type": "string"}, "chain_id": {"type": "integer"},
        "available": {"type": "boolean"}, "finalized_block": {"type": "integer"},
        "receipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/receipt"}]}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["transaction_hash", "status", "block_number", "logs"],
      "properties": {
        "transaction_hash": {"type": "string"},
        "status": {"type": "string"}, "block_number": {"type": "integer"},
        "logs": {"type": "array", "items": {"$ref": "#/$defs/log"}}
      }
    },
    "log": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "topics", "data", "log_index", "transaction_hash", "removed"],
      "properties": {
        "address": {"type": "string"},
        "topics": {"type": "array", "items": {"type": "string"}},
        "data": {"type": "string"}, "log_index": {"type": "string"},
        "transaction_hash": {"type": "string"}, "removed": {"type": "boolean"}
      }
    }
  }
}
